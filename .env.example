# Copy to .env.local and fill in. Nothing here is required to run the site:
# missing values just switch the related feature to a safe fallback.

# Canonical origin (Open Graph, sitemap, JSON-LD). Defaults to https://altronixsoft.com
NEXT_PUBLIC_SITE_URL=

# Scheduling link (Cal.com / Calendly). When empty, every "Book a 30-minute call" button is hidden.
NEXT_PUBLIC_BOOKING_URL=

# --- Contact form delivery (src/app/api/contact/route.ts) -------------------------
# Where messages are delivered.
CONTACT_TO=info@altronixsoft.com
# "From" address. Must belong to a domain verified with your provider.
CONTACT_FROM="Altronix Website <no-reply@altronixsoft.com>"

# Option A: Resend (https://resend.com)
RESEND_API_KEY=

# Option B: SMTP (used only when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Staging/testing ONLY: accepts submissions without sending anything (set to 1). In production every lead would be lost, so the server logs a warning.
CONTACT_DRY_RUN=

# With neither Resend nor SMTP configured the form falls back to a prefilled mailto: link.
